# HeyBuddy backend configuration. Copy to .env for local development ONLY.
# In production set these as deployment secrets (Render/Fly/Railway). Never commit real values.

# production | development. Production enforces HTTPS (X-Forwarded-Proto) and HSTS.
HEYBUDDY_ENV=development

# Long random string. The phone sends it once to /v1/pair to get a per-device token.
# Rotate it after pairing your devices; existing device tokens keep working.
HEYBUDDY_PAIRING_SECRET=change-me-to-a-long-random-string

# Server-side pepper for hashing device tokens at rest (HMAC-SHA256). Long random string.
HEYBUDDY_TOKEN_PEPPER=change-me-to-another-long-random-string

# SQLite file for devices, connections, proposals and logs (mount a volume in production).
HEYBUDDY_DB_PATH=./data/heybuddy.db

# Vercel AI Gateway (OpenAI-compatible Chat Completions). https://vercel.com/docs/ai-gateway
AI_GATEWAY_API_KEY=
AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v1
HEYBUDDY_DEFAULT_MODEL=anthropic/claude-sonnet-5.5
HEYBUDDY_ALLOWED_MODELS=anthropic/claude-sonnet-5.5,anthropic/claude-haiku-4.5,anthropic/claude-opus-5,openai/gpt-5,google/gemini-3-flash
HEYBUDDY_MAX_TOKENS_CAP=4096

# Gradium (TTS + optional STT). https://docs.gradium.ai  Leave the key empty to disable.
GRADIUM_API_KEY=
GRADIUM_BASE_URL=https://api.gradium.ai/api
GRADIUM_VOICE_ID=YTpq7expH9539ERJ
GRADIUM_STT_ENABLED=false
GRADIUM_STT_LANGUAGE=en

# Composio (integrations). https://docs.composio.dev  Leave the key empty to disable.
COMPOSIO_API_KEY=
COMPOSIO_BASE_URL=https://backend.composio.dev/api/v3.1
# toolkit_slug:auth_config_id pairs you created in the Composio dashboard, comma separated.
COMPOSIO_AUTH_CONFIGS=gmail:ac_xxxxxxxx,googlecalendar:ac_yyyyyyyy
# Where the OAuth flow returns when done (an https page you control, or the app's deep link).
COMPOSIO_CALLBACK_URL=

# Per device token: requests per minute.
HEYBUDDY_RATE_LIMIT_PER_MINUTE=60
