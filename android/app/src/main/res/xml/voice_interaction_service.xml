<?xml version="1.0" encoding="utf-8"?>
<!-- sessionService + recognitionService + supportsAssist are what the assistant role checks for. -->
<voice-interaction-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:sessionService="com.heybuddy.android.assist.HeyBuddySessionService"
    android:recognitionService="com.heybuddy.android.assist.HeyBuddyRecognitionService"
    android:settingsActivity="com.heybuddy.android.ui.MainActivity"
    android:supportsAssist="true"
    android:supportsLaunchVoiceAssistFromKeyguard="false"
    android:supportsLocalInteraction="false" />
